# Test-only environment — no real secrets here. Points at the disposable
# Postgres container from docker-compose.test.yml, not the real database.
# SUPABASE_*/RESEND_API_KEY are dummy values: mailer/storage are mocked in
# every test that would otherwise touch them, so these never see real
# network calls, but env.ts's fail-fast validation still requires them
# to be present.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jyo_test
JWT_SECRET=test-only-jwt-secret-not-for-production-use-000000000000
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
RESEND_API_KEY=test-resend-key
APP_URL=http://localhost:5173
APP_ENV=test
PORT=3001
# A throwaway key pair for the push tests (web-push is mocked); production
# uses its own pair, set only in Render.
VAPID_PUBLIC_KEY=BGgz9OjYewYVHeI23gxKkPHStLGquj_m236E9EMzR8FkBi9SSOiaGgoB_haBGwM3CIIuavn0utvm9_svGOJAgCw
VAPID_PRIVATE_KEY=yJIEhLF7QMahXIQDMO78TOw5D1OJLP_p8VD7z2iktKg
VAPID_SUBJECT=mailto:test@example.com

# The admin portal's test account
ADMIN_EMAILS=admin@example.com
