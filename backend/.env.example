# Server
PORT=3000
APP_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/database

# Authentication
JWT_SECRET=your_strong_jwt_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Application URL
APP_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key

# Sentry error tracking (optional — leave unset to disable)
SENTRY_DSN=
# Push notifications (optional — leave unset to disable). Generate the pair
# once with `pnpm exec web-push generate-vapid-keys` and never change it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Where reports of posts and people are emailed (optional; they're stored either way)
REPORTS_EMAIL=

# Who can open the admin portal (comma-separated; the account must be verified)
ADMIN_EMAILS=
